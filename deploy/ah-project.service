[Unit]
Description=AH Project Jetson risk detection
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ahproject
Group=ahproject
WorkingDirectory=/opt/ah-project
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/ah-project/ah-project.env
ExecStart=/opt/ah-project/.venv-jetson/bin/python /opt/ah-project/run.py --config /opt/ah-project/config/jetson_orin_nx_rtsp.yaml
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
